%% cp-14-tech-soap-screen-flow · v1.0 · 2026-07-20
%% SSOT: cockpit — SOAP core, three flows, case layer (EpisodeOfCare)
%% Authority: proposed by Patrik · approved by Roman · applied by Dominika/Viktor
flowchart TD
  subgraph CASE["EpisodeOfCare — case (outpatient degenerates to a single encounter)"]
    subgraph ENC["Encounter — department / visit"]
      PLUS["+ menu: Rx / Order / Note / Follow-up"] --> RXM[Rx modal]
      PLUS --> ORDM["Order modal — Radiology / Labs"]
      PLUS --> NOTE["One-line note — defaults to A"]
      COMM[Communication] -->|one-click extract| S
      RXM -->|MedicationRequest| P
      ORDM -->|ServiceRequest| P
      NOTE -->|Condition/text| A
      VIT["Vitals / PHR"] -->|Observation| O
      subgraph DEK["Progress note — background compilation (Composition)"]
        S; O; A; P
      end
      DEK --> SIGN["Signature — market_rules validation<br/>IN: A+P · EU/US: full"]
      SIGN --> CHG["ChargeItem candidates — confirmed by the physician"]
    end
    ORDM -.-> PEND["Pending result — open loop"] -.->|result| O
    ENC -->|"handoff: IQ summary (ISBAR)"| ENC2["Encounter — next department"]
    ENC2 --> DIS["Discharge / case closure"]
    ENC --> DIS
  end
  SIGN --> OUT1["Render: Rx slip (IN)"]
  SIGN --> OUT2["Render: full report (EU/US) including eRx + follow-up"]
  CHG --> AGG["Aggregation per episode → bill / DRG batch / Invoice"]
  DIS --> AGG
