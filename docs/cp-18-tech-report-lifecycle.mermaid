%% cp-18-tech-report-lifecycle
%% Report lifecycle: capture → progress note → signature → render → sharing
%% Normative source: cp-17-tech-report-conformance-standard
%% type: informative (a visualisation of the standard, not an authority of its own)

flowchart TD

  subgraph CAP["1 · CAPTURE — events are the SSOT (cp-16)"]
    A1["Physician action<br/>eRx · order · note · vitals"]
    A2["Code selection at capture<br/>type-ahead over a ValueSet<br/>TERM-05 TERM-06"]
    A3["Event = coding[] + text<br/>TERM-01 TERM-03"]
    A4["IQ suggestion<br/>labelled, never written silently<br/>DSI-01 DSI-03"]
    A1 --> A2 --> A3
    A4 -. "confirmed by the physician" .-> A3
  end

  subgraph DEK["2 · PROGRESS NOTE — continuous compilation (SOAP-03)"]
    B1["Composition<br/>sections S / O / A / P"]
    B2["status: preliminary<br/>AMD-01"]
    B1 --- B2
  end

  subgraph SGN["3 · SIGNATURE"]
    C1{"Minimum set<br/>per market_rules?<br/>SOAP-06"}
    C2["Market signature level<br/>eIDAS QES · HIPAA · IT Act<br/>SIG-01"]
    C3{"System mode?<br/>REP-01"}
    C4["overlay — the host system<br/>performs the signature<br/>REP-02 SIG-03"]
    C5["core — the authoritative<br/>Hilbi Composition<br/>REP-03"]
    C6["status: final<br/>AMD-01"]
    C1 -- "yes" --> C2 --> C3
    C1 -- "no" --> B1
    C3 -- "overlay" --> C4 --> C6
    C3 -- "core" --> C5 --> C6
  end

  subgraph REN["4 · RENDER — one object, many templates (SOAP-08)"]
    D1["Report shell<br/>header · body · footer<br/>REP-06"]
    D2["Identity from context<br/>ABHA/HPR/HFR · MRN/NPI<br/>REP-07"]
    D3["Market document profile<br/>EEHRxF · US Core · ABDM<br/>REP-08"]
    D4["DocumentReference"]
    D1 --- D2
    D1 --- D3
    D1 --> D4
  end

  subgraph SHR["5 · SHARING"]
    E1{"Signed version?<br/>CNS-05"}
    E2["Consent context<br/>ABDM CM · EHDS pou · info-blocking<br/>CNS-01..04"]
    E3["Handover to the recipient"]
    E1 -- "yes" --> E2 --> E3
    E1 -- "no" --> D1
  end

  subgraph AMD["6 · CORRECTION — never a silent edit"]
    F1["Reason for correction<br/>AMD-04"]
    F2["Addendum<br/>original preserved<br/>AMD-02 AMD-03"]
    F3["status: amended"]
    F1 --> F2 --> F3
  end

  CAP --> DEK --> SGN --> REN --> SHR
  C6 -.-> F1
  F3 -.-> D1

  subgraph PRV["Provenance and audit — cross-cutting layer (PROV / AUD)"]
    G1["Provenance · create<br/>agent: physician | Hilbi IQ<br/>PROV-01 PROV-03"]
    G2["Provenance · sign / amend<br/>role: attester"]
    G3["Provenance · verify<br/>role: verifier — claim"]
    G4["AuditEvent · copy / print / share<br/>+ purpose-of-use<br/>AUD-01"]
    G5[("Persistent, immutable<br/>tamper-evident log<br/>AUD-02 AUD-03")]
    G1 --> G5
    G2 --> G5
    G3 --> G5
    G4 --> G5
  end

  A3 -.-> G1
  C6 -.-> G2
  F2 -.-> G2
  D4 -.-> G4
  E3 -.-> G4
